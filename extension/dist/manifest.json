{
  "manifest_version": 3,
  "name": "CareerOS Job Clipper",
  "version": "1.0.0",
  "description": "Clip jobs and auto-fill applications directly from CareerOS",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://app.careeros.ai/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/contentScript.ts-loader-DR8DDk8A.js"
      ],
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.linkedin.com/*"
      ],
      "resources": [
        "assets/rolldown-runtime-D9-fqq9M.js",
        "assets/contentScript.ts-Cl8CRzS5.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
