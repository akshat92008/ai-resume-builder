# =============================================================================
# CareerOS — Production Environment Contract
# =============================================================================
# Copy to .env.local for development. Never commit real secrets.
# The /api/health readiness endpoint fails closed in production when core values
# are missing or malformed.
# =============================================================================

# --- App [REQUIRED] ---
# Local development may use http://localhost:3000. Production must use HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase [REQUIRED] ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI [REQUIRED] ---
AI_PROVIDER=nvidia
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_MODEL_FAST=meta/llama-3.1-8b-instruct

# Optional fallback providers. A key alone does NOT enable fallback; configure
# the exact model IDs you have tested so production never silently relies on a
# stale source-code model identifier.
ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACK_MODEL=
ANTHROPIC_FALLBACK_MODEL_FAST=
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=
OPENAI_FALLBACK_MODEL_FAST=

# Optional AI economics rates, USD per 1M tokens. Leave blank if unknown.
# Pricing changes; keep these values in deployment configuration, not code.
NVIDIA_INPUT_COST_PER_MILLION_USD=
NVIDIA_OUTPUT_COST_PER_MILLION_USD=
ANTHROPIC_INPUT_COST_PER_MILLION_USD=
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD=
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=

# --- Inngest [REQUIRED in production] ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Upstash [REQUIRED in production] ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=                           # random value, minimum 16 chars in production

# --- Billing [OPTIONAL for core/free commercial deployment] ---
# Leave ALL billing values blank to deploy the core Free product without billing.
# If enabling paid subscriptions, configure the entire provider block together.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PRO_TOTAL_COUNT=

# --- Observability [SENTRY OPTIONAL ON VERCEL CONTROLLED BETA] ---
# CareerOS always emits privacy-sanitized structured server logs. On Vercel, a
# first-party browser-error endpoint adds rate-limited error fingerprints to
# Vercel Runtime Logs, which satisfies the controlled-beta observability gate.
# Configure both DSNs to use Sentry instead / in addition. External alerting is
# still recommended before broad public or paid GA.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Support [REQUIRED in production] ---
# Set a real monitored inbox before commercial deployment.
NEXT_PUBLIC_SUPPORT_EMAIL=

# NODE_ENV is set by the deployment platform. Do not force production locally.
