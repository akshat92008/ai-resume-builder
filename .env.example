# =============================================================================
# CareerOS V1 — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables marked [REQUIRED] must be set for the app to function.
# Variables marked [OPTIONAL] enable additional features.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000       # [REQUIRED] Public URL of the app

# --- Supabase (Persistence) ---
# [REQUIRED] App/API access requires Supabase auth and persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Provider ---
# [REQUIRED] Powers LLM-based resume generation, tailoring, and analysis.
AI_PROVIDER=nvidia                         # [RESERVED] NVIDIA NIM is the current primary provider
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_MODEL_FAST=meta/llama-3.1-8b-instruct
ANTHROPIC_API_KEY=                         # [OPTIONAL] Fallback provider
OPENAI_API_KEY=                            # [OPTIONAL] Fallback provider

# --- Inngest (Background Jobs) ---
# [REQUIRED for production] Powers async AI orchestration.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Upstash Redis (Rate Limiting) ---
# [REQUIRED for production] The app fails closed if these are missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (Payments) ---
# [OPTIONAL] Required only if payments/subscriptions are enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Security ---
RATE_LIMIT_SALT=                                # [REQUIRED for production] Random string for IP hashing
NODE_ENV=development                            # Set to "production" in deployment

# --- Observability ---
# [REQUIRED for production] Error tracking via Sentry.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Support ---
NEXT_PUBLIC_SUPPORT_EMAIL=support@amauralabs.com
